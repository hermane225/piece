generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Condition {
  NEUF
  QUASI_NEUF
  RECONDITIONNE
  SECONDE_MAIN
}

enum Category {
  PHONE
  PC
  AUTO_MOTO
  AUTO_PARTS
  MOTO_PARTS
  AUTO_ACCESSORIES
  AUTO_EQUIPMENT
  APPLIANCES
  FRIDGE_PARTS
  WASHING_MACHINE_PARTS
  AC_PARTS
  MICROWAVE_PARTS
  HOME_DIY
  TOOLS
  ELECTRICAL_MATERIAL
  PLUMBING
  CARPENTRY
  ENERGY_INDUSTRY
  GENERATORS
  SOLAR_PANELS
  INDUSTRIAL_BATTERIES
  INDUSTRIAL_MACHINE_PARTS
  MULTIMEDIA_GAMING
  CONSOLES
  CONTROLLERS
  CONSOLE_PARTS
  GAMING_ACCESSORIES
  OTHER_VEHICLES
  BICYCLE
  SCOOTER
  VARIOUS_PARTS
}

enum NotificationType {
  CHAT_MESSAGE
  RECOMMENDATION
  SYSTEM
}

enum PostStatus {
  ACTIVE
  SOLD
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum BoostPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum VerificationDocumentType {
  CNI
  PERMIS
  AUTRE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TechnicianSpecialty {
  COMPUTER_REPAIR
  PLUMBER
  ELECTRICIAN
  CARPENTER
  AC_TECHNICIAN
  APPLIANCES_REPAIR
  AUTO_REPAIR
  MOTO_REPAIR
  SOLAR_INSTALLATION
  ELECTRICAL_EQUIPMENT
  INDUSTRIAL_EQUIPMENT
  GAMING_CONSOLE_REPAIR
  OTHER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String   @unique
  password  String
  resetPasswordToken     String?
  resetPasswordExpiresAt DateTime?
  autoApprovePosts       Boolean  @default(false)
  isVerifiedSeller       Boolean  @default(false)
  ratingSum              Float    @default(0)
  reviewsCount           Int      @default(0)
  city      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]
  sentMessages               ChatMessage[]             @relation("SentMessages")
  conversations              ConversationParticipant[]
  notifications              Notification[]
  categoryPreferences        UserCategoryPreference[]
  searchActivities           UserSearchActivity[]
  presence                   UserPresence?
  techniciansCreated         Technician[]             @relation("TechnicianCreatedBy")
  boostPayments              BoostPayment[]
  verifications              SellerVerification[]     @relation("VerificationSubmittedBy")
  reviewedVerifications      SellerVerification[]     @relation("VerificationReviewedBy")
  ordersAsSeller             Order[]                  @relation("OrderSeller")
  ordersAsBuyer              Order[]                  @relation("OrderBuyer")
  reviewsWritten             Review[]                 @relation("ReviewAuthor")
  reviewsReceived            Review[]                 @relation("ReviewTarget")

  @@index([isVerifiedSeller])
  @@map("users")
}

model Post {
  id          String    @id @default(uuid())
  title       String
  description String
  price       Float
  condition   Condition
  brand       String
  model       String
  category    Category
  city        String
  images      String[]
  isApproved  Boolean   @default(false)
  boostedUntil DateTime? // Date jusqu'à laquelle l'annonce est boostée
  boostPaymentReference String?
  boostPaymentAmount    Float?
  boostPaidAt           DateTime?
  status      PostStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  boostPayments BoostPayment[]
  orders        Order[]
  conversations Conversation[]

  @@index([status])
  @@map("posts")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  image     String
  comment   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Conversation {
  id           String                    @id @default(uuid())
  postId       String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     ChatMessage[]
  post         Post?                     @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model UserCategoryPreference {
  id        String   @id @default(uuid())
  userId    String
  category  Category
  weight    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("user_category_preferences")
}

model UserSearchActivity {
  id        String    @id @default(uuid())
  userId    String
  query     String
  category  Category?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([category])
  @@map("user_search_activities")
}

model UserPresence {
  userId      String   @id
  isOnline    Boolean  @default(false)
  lastSeenAt  DateTime
  socketCount Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isOnline])
  @@index([updatedAt])
  @@map("user_presence")
}

model Technician {
  id                String                 @id @default(uuid())
  name              String
  phone             String                 @unique
  specialty         TechnicianSpecialty
  city              String
  email             String?
  description       String?
  address           String?
  certifications    String?
  yearsOfExperience Int?
  hourlyRate        Float?
  availability      String?                // JSON string pour les horaires
  status            Boolean                @default(true) // true = actif, false = inactif
  createdByAdminId  String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  createdByAdmin    User                   @relation("TechnicianCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([specialty])
  @@index([city])
  @@index([status])
  @@index([createdByAdminId])
  @@map("technicians")
}

model BoostPayment {
  id           String             @id @default(uuid())
  reference    String             @unique
  checkoutUrl  String?
  amount       Float
  days         Int
  status       BoostPaymentStatus @default(PENDING)
  metadata     Json?
  postId       String
  userId       String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  completedAt  DateTime?
  failedAt     DateTime?
  errorMessage String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([status])
  @@map("boost_payments")
}

model SellerVerification {
  id                String                   @id @default(uuid())
  userId            String
  documentType      VerificationDocumentType
  documentPublicId  String
  documentFormat    String
  status            VerificationStatus       @default(PENDING)
  rejectionReason   String?
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  user            User  @relation("VerificationSubmittedBy", fields: [userId], references: [id], onDelete: Cascade)
  reviewedByAdmin User? @relation("VerificationReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("seller_verifications")
}

model Order {
  id          String      @id @default(uuid())
  postId      String?
  postTitle   String
  sellerId    String
  buyerId     String
  price       Float
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  confirmedAt DateTime?
  cancelledAt DateTime?

  post    Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  seller  User     @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer   User     @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  reviews Review[]

  @@index([postId])
  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

model Review {
  id        String   @id @default(uuid())
  orderId   String
  authorId  String
  targetId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target User  @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([orderId, authorId])
  @@index([targetId])
  @@map("reviews")
}

model WebhookEvent {
  id           String   @id @default(uuid())
  provider     String
  eventId      String
  eventName    String
  payload      Json
  processedAt  DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventName])
  @@map("webhook_events")
}

