# Database (PostgreSQL - Render)
DATABASE_URL="postgresql://username:password@host:5432/database"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# SMTP (mot de passe oublié)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="no-reply@piece-rare.ci"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# GeniusPay (boosts)
# Mode actuel: sandbox ou live
GENIUSPAY_MODE="sandbox"

# Clés API par environnement
GENIUSPAY_API_KEY_SANDBOX="pk_sandbox_your_public_key"
GENIUSPAY_API_SECRET_SANDBOX="sk_sandbox_your_secret_key"
GENIUSPAY_API_KEY_LIVE="pk_live_your_public_key"
GENIUSPAY_API_SECRET_LIVE="sk_live_your_secret_key"

# Compatibilité legacy si tu n'utilises qu'une seule paire de clés
# GENIUSPAY_API_KEY="pk_live_your_public_key"
# GENIUSPAY_API_SECRET="sk_live_your_secret_key"

GENIUSPAY_BASE_URL="https://geniuspay.ci/api/v1/merchant"
GENIUSPAY_WEBHOOK_SECRET_SANDBOX="whsec_sandbox_your_webhook_secret"
GENIUSPAY_WEBHOOK_SECRET_LIVE="whsec_live_your_webhook_secret"
# GENIUSPAY_WEBHOOK_SECRET="whsec_your_webhook_secret"
GENIUSPAY_SUCCESS_URL="https://piece.blueredc.com/"


# Server
PORT=3000


# CORS (prod)
# Use FRONTEND_URL for a single origin or FRONTEND_URLS for a comma-separated list
FRONTEND_URL="https://piece-rare.ci"
# FRONTEND_URLS="https://piece-rare.ci,https://piece.blueredc.com,http://localhost:8081"

